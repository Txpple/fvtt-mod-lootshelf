{{!-- Loot container header: portrait, name, and one line about the chest. Markup mirrors
      the dnd5e group sheet header so the system's own styling dresses it, and the subtitle
      matches the shelf's so the two windows read as the same object.

      The subtitle defaults to what the chest is worth and can be typed over by a GM; see
      `_prepareContext` in container-sheet.js. The GM's input is NOT a form field — these
      sheets open un-editable, so it is written straight to the flag on change. --}}
<header class="sheet-header">

    <div class="left">
        <div class="portrait">
            <img src="{{ document.img }}" alt="{{ document.name }}"
                {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
        </div>
    </div>

    <div class="right">
        <div class="top">
            {{#if editable}}
            <input type="text" name="name" class="document-name uninput" value="{{ actor._source.name }}">
            {{else}}
            <div class="document-name">{{ document.name }}</div>
            {{/if}}
        </div>
        {{#if loot.isGM}}
        <input type="text" class="lootshelf-note lootshelf-subtitle uninput always-interactive"
               value="{{ loot.note }}" placeholder="{{ loot.summary }}"
               aria-label="Note shown under the container's name">
        {{else if loot.subtitle}}
        <div class="lootshelf-subtitle">{{ loot.subtitle }}</div>
        {{/if}}
    </div>

</header>
