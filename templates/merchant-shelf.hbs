<section class="lootshelf-body">
  <header class="lootshelf-header">
    <img class="portrait" src="{{merchant.img}}" alt="{{merchant.name}}">
    <div class="titles">
      <h3>{{merchant.name}}</h3>
      <p class="hint">Buys your goods at {{sellPct}}% of value{{#if priceNote}} &middot; {{priceNote}}{{/if}}</p>
    </div>
  </header>

  <ol class="lootshelf-stock">
    {{#each rows}}
      <li class="stock-row{{#if hidden}} is-hidden{{/if}}" data-item-id="{{id}}">
        <img class="icon" src="{{img}}" alt="">
        <span class="name">{{name}}</span>
        <span class="qty">&times;{{qty}}</span>
        <span class="price">{{priceLabel}}</span>
        {{#if ../isGM}}
          <a class="control" data-action="toggleHidden"
             data-tooltip="{{#if hidden}}Show on shelf{{else}}Hide from shelf{{/if}}">
            <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
          </a>
        {{else}}
          <input class="buy-qty" type="number" value="1" min="1">
          <button type="button" class="buy" data-action="buy">Buy</button>
        {{/if}}
      </li>
    {{else}}
      <li class="empty">Nothing is for sale right now.</li>
    {{/each}}
  </ol>

  <footer class="lootshelf-footer">
    {{#if buyer}}
      <p class="purse"><i class="fa-solid fa-coins"></i> {{buyer.name}} &mdash; {{buyer.coins}}</p>
      <div class="lootshelf-sellzone">Drag an item here to sell it to {{merchant.name}}</div>
    {{/if}}
    {{#if isGM}}
      <p class="hint">The eye icons hide items from players. Stock the shelf by dragging
        items onto this merchant's sheet; equipped gear never shows.</p>
    {{/if}}
  </footer>
</section>
